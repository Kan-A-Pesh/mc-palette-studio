{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @app/realtime build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @app/realtime start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "pr": {
      "deploy": {
        "startCommand": "pnpm --filter @app/realtime start"
      }
    }
  }
}

